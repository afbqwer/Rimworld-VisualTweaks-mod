<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Vacuum leak airflow: converging streams at ventilation ports, the short jet
    a hull breach blows into space, and the radial suction disc left when a
    ceiling is opened (Odyssey vacuum maps only).

    Queue 3177 sits above the vanilla vacuum fog (3170) and dust (3171), above
    fog of war / terrain curtain / sun shadow fade (3175) and gravship shadow
    (3176), below this mod's shockwave (3178) and the darkness layer (3180).
    3175 itself is occupied by three vanilla shaders, so the effect must not
    land there despite the analysis doc suggesting that slot.

    The scene grab uses the same queue, so it holds the terrain, the vanilla
    vacuum fog, dust and pawns, but never the stream itself. That lets the
    optional refraction bend everything behind the air without feeding back.
  -->
  <ShaderDef>
    <defName>VisualTweaksVacuumLeak</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksVacuumLeak.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksVacuumLeak.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3177</renderQueue>
      <sceneGrab>
        <name>VisualTweaksVacuumLeak</name>
        <queue>3177</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>
</Defs>