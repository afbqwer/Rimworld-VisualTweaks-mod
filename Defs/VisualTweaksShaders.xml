<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    GPU ribbon expansion for the wind particle style. Draws under the fog/overlay
    queue exactly like the CPU particle layer (DashRenderQueue 2991).
  -->
  <ShaderDef>
    <defName>VisualTweaksAOWindGpu</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksAOWindGpu.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksAOWindGpu.frag.glsl</fragmentShaderFileName>
      <useTexture>true</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>2991</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Single view-sized quad that shades the gas/mist density field in the fragment
    stage. Queue 2990 keeps it below RimWorld's transparent overlay/fog materials,
    so fog of war and darkness cover it the same way they cover terrain.
  -->
  <ShaderDef>
    <defName>VisualTweaksGasField</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksGasField.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksGasField.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>2990</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_GasTexCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexPrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MistTexCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MistTexPrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexWideCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexWidePrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_WindTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Low-temperature room mist.

    Same queue as the heat haze: 3174 sits after the normal map visuals and before
    fog of war (3175), so darkness and fog of war cover the mist exactly like they
    cover terrain and neither has to be handled in the shader.

    There is no <sceneGrab> block on purpose. Mist is a translucent cloud blended
    over the scene, so it needs no copy of the framebuffer, and the mask can sit at
    sampler binding 1.
  -->
  <ShaderDef>
    <defName>VisualTweaksColdMist</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksColdMist.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksColdMist.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3174</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_ColdMask</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    High-temperature air shimmer.

    Queue 3174 sits after the normal map visuals and before fog of war (3175),
    so fog and darkness cover the effect exactly like they cover terrain. The
    scene grab uses the same queue, which makes the grab contain everything the
    shimmer is allowed to distort. The name is unique so it cannot collide with
    another mod's "Distortion" grab.
  -->
  <ShaderDef>
    <defName>VisualTweaksHeatHaze</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksHeatHaze.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksHeatHaze.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3174</renderQueue>
      <sceneGrab>
        <name>VisualTweaksHeatHaze</name>
        <queue>3174</queue>
      </sceneGrab>
      <textureWrapOverrides>
        <li>
          <key>_HeatMask</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Vacuum leak airflow: converging streams at ventilation ports, the short jet
    a hull breach blows into space, and the radial suction disc left when a
    ceiling is opened (Odyssey vacuum maps only).

    Queue 3177 sits above the vanilla vacuum fog (3170) and dust (3171), above
    fog of war / terrain curtain / sun shadow fade (3175) and gravship shadow
    (3176), below this mod's shockwave (3178) and the darkness layer (3180).
    3175 itself is occupied by three vanilla shaders, so the effect must not
    land there despite the analysis doc suggesting that slot.

    The scene grab uses the same queue, so it holds the terrain, the vanilla
    vacuum fog, dust and pawns, but never the stream itself. That lets the
    optional refraction bend everything behind the air without feeding back.
  -->
  <ShaderDef>
    <defName>VisualTweaksVacuumLeak</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksVacuumLeak.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksVacuumLeak.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3177</renderQueue>
      <sceneGrab>
        <name>VisualTweaksVacuumLeak</name>
        <queue>3177</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!--
    Screen-space refraction shockwave for explosions.

    The scene grab is taken at 3178, after fog of war (3175) and before darkness
    (3180). The quad itself is drawn at the same queue and only covers the blast
    radius, so this is not a full-screen post-process pass.
  -->
  <ShaderDef>
    <defName>VisualTweaksExplosionRipple</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksExplosionRipple.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksExplosionRipple.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3178</renderQueue>
      <sceneGrab>
        <name>VisualTweaksExplosionRipple</name>
        <queue>3178</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!--
    Crisp-edged projectile-interceptor shield, replacing vanilla's PostDraw.

    Queue 3151 and Additive are copied verbatim from vanilla's Map/MoteGlow, which
    is what the stock ForceField material uses. The shield therefore keeps its place
    in the layer stack exactly — under fog of war, over the map, added rather than
    blended — and only its shape on screen changes. Raising this above 3175 would
    make shields glow through fog of war, which vanilla deliberately does not do.
  -->
  <ShaderDef>
    <defName>VisualTweaksShieldDome</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksShieldDome.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksShieldDome.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Additive</blendMode>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>
</Defs>
