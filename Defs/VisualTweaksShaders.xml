<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    GPU ribbon expansion for the wind particle style. Draws under the fog/overlay
    queue exactly like the CPU particle layer (RenderQueue 2991 in WindFlowRenderer).
  -->
  <ShaderDef>
    <defName>VisualTweaksAOWindGpu</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksAOWindGpu.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksAOWindGpu.frag.glsl</fragmentShaderFileName>
      <useTexture>true</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>2991</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Single view-sized quad that shades the gas/mist density field in the fragment
    stage. Queue 2991 is shared with the wind layer; both stay below RimWorld's
    transparent overlay/fog materials, so fog of war and darkness cover them the
    same way they cover terrain. The gas quad, the wind guide line and the streaks
    are ordered by altitude inside that queue, so one slot covers all three.
  -->
  <ShaderDef>
    <defName>VisualTweaksGasField</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksGasField.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksGasField.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>2991</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_GasTexCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexPrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MistTexCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_MistTexPrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexWideCur</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_GasTexWidePrev</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_WindTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Low-temperature room mist.

    Same queue as the heat haze: 3174 sits after the normal map visuals and before
    fog of war (3175), so darkness and fog of war cover the mist exactly like they
    cover terrain and neither has to be handled in the shader.

    There is no <sceneGrab> block on purpose. Mist is a translucent cloud blended
    over the scene, so it needs no copy of the framebuffer, and the mask can sit at
    sampler binding 1.
  -->
  <ShaderDef>
    <defName>VisualTweaksColdMist</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksColdMist.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksColdMist.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3174</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_ColdMask</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    High-temperature air shimmer.

    Queue 3174 sits after the normal map visuals and before fog of war (3175),
    so fog and darkness cover the effect exactly like they cover terrain. The
    scene grab uses the same queue, which makes the grab contain everything the
    shimmer is allowed to distort. The name is unique so it cannot collide with
    another mod's "Distortion" grab.
  -->
  <ShaderDef>
    <defName>VisualTweaksHeatHaze</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksHeatHaze.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksHeatHaze.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3174</renderQueue>
      <sceneGrab>
        <name>VisualTweaksHeatHaze</name>
        <queue>3174</queue>
      </sceneGrab>
      <textureWrapOverrides>
        <li>
          <key>_HeatMask</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Vacuum leak airflow: converging streams at ventilation ports, the short jet
    a hull breach blows into space, and the radial suction disc left when a
    ceiling is opened (Odyssey vacuum maps only).

    Queue 3179 sits above the vanilla vacuum fog (3170) and dust (3171), above
    fog of war / terrain curtain / sun shadow fade (3175), gravship shadow (3176)
    and gravship distortion (3178), and below the darkness layer (3180). 3175
    itself is occupied by three vanilla shaders, so the effect must not land
    there despite the analysis doc suggesting that slot.

    The shockwave below uses the same queue and the same grab: both need exactly
    the post-fog, pre-darkness frame, so one declaration feeds both shaders and
    Waylith copies the frame once instead of twice. Within the queue the two are
    ordered by altitude (the shockwave sits above the air layer), not by number.
  -->
  <ShaderDef>
    <defName>VisualTweaksVacuumLeak</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksVacuumLeak.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksVacuumLeak.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3179</renderQueue>
      <sceneGrab>
        <name>VisualTweaksRefraction</name>
        <queue>3179</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!--
    Screen-space refraction shockwave for explosions.

    Shares the vacuum leak's queue and scene grab (see above): the grab is taken
    at 3179, after fog of war (3175) and before darkness (3180), and contains
    everything the shockwave may bend. The quad itself covers only the blast
    radius, so this is not a full-screen post-process pass.
  -->
  <ShaderDef>
    <defName>VisualTweaksExplosionRipple</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksExplosionRipple.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksExplosionRipple.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3179</renderQueue>
      <sceneGrab>
        <name>VisualTweaksRefraction</name>
        <queue>3179</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>

  <!--
    Projectile-interceptor shield dome, replacing vanilla's PostDraw. One shader
    draws all five styles (crisp ring, hexagonal panel shell, the two stock-like
    profiles, and the hex bubble); the style is a material uniform, so the quad
    and draw count never change.

    Queue 3151 and Additive are copied verbatim from vanilla's Map/MoteGlow, which
    is what the stock ForceField material uses. The shield therefore keeps its place
    in the layer stack exactly — under fog of war, over the map, added rather than
    blended — and only its shape on screen changes. Raising this above 3175 would
    make shields glow through fog of war, which vanilla deliberately does not do.
  -->
  <ShaderDef>
    <defName>VisualTweaksShieldDome</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksShieldDome.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksShieldDome.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Additive</blendMode>
      <renderQueue>3151</renderQueue>
      <!--
        The optional hexagonal style samples a baked spherical Voronoi map at
        binding 1. It is generated in C# (ShieldHexMap) rather than shipped as an
        asset, and Clamp is required because the disc edges are outside the
        hemisphere projection, not a tile seam.
      -->
      <textureWrapOverrides>
        <li>
          <key>_HexMap</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <!--
    Bullet-impact sparks on mechanoids, fully procedural: the fragment shader
    hashes out every spark streak, no texture is sampled and no scene grab is
    needed (additive light, not refraction).

    Queue 3151 and Additive are copied verbatim from vanilla's Map/MoteGlow,
    the same slot the shield dome uses: sparks are motes in everything but
    name, so they stay under fog of war and darkness exactly like vanilla's
    own impact flecks. Within the queue they sit above the shield dome by
    altitude (MoteOverhead), so a hit on a shielded mech still shows its spray.
  -->
  <ShaderDef>
    <defName>VisualTweaksMechSpark</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksMechSpark.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksMechSpark.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Additive</blendMode>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!--
    Building-impact debris and dust, fully procedural: chips are rotating box
    SDFs, smoke is hash-based fbm noise — no texture is sampled and no scene
    grab is needed.

    Queue 3151 is vanilla's Map/Mote slot (under fog of war and darkness, like
    the sparks), but the blend is Alpha, not Additive: debris and dust are
    matter that occludes what is behind it, not light. Within the queue the
    bursts sit one AltInc above the sparks, so a metal wall hit shows chips on
    top of any spark flash.
  -->
  <ShaderDef>
    <defName>VisualTweaksBuildingImpact</defName>
    <shaderProgram>
      <vertexShaderFileName>VisualTweaksBuildingImpact.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>VisualTweaksBuildingImpact.frag.glsl</fragmentShaderFileName>
      <useTexture>false</useTexture>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>true</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Alpha</blendMode>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>
</Defs>
